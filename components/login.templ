package components

import (
	"context"
	"strings"
)

templ Login(ctx context.Context, errorMessage string, hasExternalProviders bool) {
	@LayoutWithContext("Login", ctx) {
		<div class="flex items-center justify-center py-10 px-4 gm-safe-x" style="min-height:calc(100vh - 4rem)">
			<div class="w-full max-w-sm">
				<div class="flex items-center gap-2.5 mb-5">
					<img src="/static/img/logo.png" alt="" class="w-8 h-8"/>
					<div>
						<p class="gm-page-title leading-6">GoMFT</p>
						<p class="gm-muted">Managed file transfer</p>
					</div>
				</div>
				<div class="gm-card">
					<div class="gm-card-body">
						<h1 class="gm-section-title mb-1">Sign in</h1>
						<p class="gm-muted mb-5">Use your GoMFT account to continue.</p>
						if errorMessage != "" {
							if strings.HasPrefix(errorMessage, "Password reset") || strings.Contains(errorMessage, "success") {
								<div class="mb-4 flex items-start gap-2 rounded-md p-3" style="background:var(--ok-bg);border:1px solid var(--ok-line);color:var(--ok)" role="status">
									<i class="fas fa-check-circle mt-0.5" aria-hidden="true"></i>
									<span class="text-sm">{ errorMessage }</span>
								</div>
							} else {
								<div class="mb-4 flex items-start gap-2 rounded-md p-3" style="background:var(--bad-bg);border:1px solid var(--bad-line);color:var(--bad)" role="alert">
									<i class="fas fa-exclamation-circle mt-0.5" aria-hidden="true"></i>
									<span class="text-sm">{ errorMessage }</span>
								</div>
							}
						}
						<form
							class="space-y-4"
							method="POST"
							action="/login"
							x-data="{ 
								email: '', 
								password: '',
								loading: false,
								validate() {
									return this.email && this.password;
								}
							}"
						>
							<div>
								<label for="email" class="gm-label">Email address</label>
								<input
									id="email"
									name="email"
									type="email"
									autocomplete="username"
									required
									x-model="email"
									class="gm-input"
									placeholder="you@example.com"
								/>
							</div>
							<div>
								<div class="flex items-baseline justify-between">
									<label for="password" class="gm-label">Password</label>
									<a href="/forgot-password" class="gm-muted hover:underline" style="color:var(--accent-text)">Forgot password?</a>
								</div>
								<input
									id="password"
									name="password"
									type="password"
									autocomplete="current-password"
									required
									x-model="password"
									class="gm-input"
									placeholder="••••••••"
								/>
							</div>
							<div class="flex items-center gap-2">
								<input
									id="remember-me"
									name="remember-me"
									type="checkbox"
									class="w-4 h-4 rounded"
									style="accent-color:var(--accent-ring)"
								/>
								<label for="remember-me" class="gm-meta">Keep me signed in</label>
							</div>
							<button
								type="submit"
								class="gm-btn gm-btn-primary w-full"
								x-bind:disabled="!validate()"
								x-bind:class="!validate() ? 'opacity-50 cursor-not-allowed' : ''"
								@click="loading = true"
							>
								<span x-show="!loading" class="flex items-center gap-2">
									<i class="fas fa-sign-in-alt" aria-hidden="true"></i>
									Sign in
								</span>
								<span x-show="loading" x-cloak class="flex items-center gap-2">
									<i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
									Signing in…
								</span>
							</button>
						</form>
						if hasExternalProviders {
							<div id="external-auth-providers" class="mt-5 pt-5 gm-border-t">
								<p class="gm-eyebrow mb-2.5">Or continue with</p>
								<div id="provider-buttons" class="flex flex-col gap-2" hx-get="/auth/providers" hx-trigger="load" hx-target="#provider-buttons">
									<div class="h-10 rounded animate-pulse" style="background:var(--surface-2)"></div>
								</div>
							</div>
						}
					</div>
					<div class="px-4 py-3 gm-border-t">
						<p class="gm-muted">
							<i class="fas fa-info-circle mr-1" aria-hidden="true"></i>
							Contact an administrator to create an account.
						</p>
					</div>
				</div>
				<p class="mt-4 gm-muted flex items-center gap-2">
					<i class="fas fa-shield-alt" aria-hidden="true" style="color:var(--accent-text)"></i>
					Secure, encrypted connection
				</p>
			</div>
		</div>
	}
}
