package components

import (
	"context"
	"fmt"
	"github.com/starfleetcptn/gomft/internal/db"
)

// Dialog component for confirmation dialogs using Flowbite modal
templ JobDialog(id string, title string, message string, confirmClass string, confirmText string, action string, jobID uint, jobName string) {
	<div id={ id } tabindex="-1" aria-hidden="true" role="dialog" aria-labelledby={ id + "-title" } class="hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full max-h-full" style="height:calc(100% - 1rem)">
		<!-- Backdrop -->
		<div id={ fmt.Sprintf("%s-backdrop", id) } class="fixed inset-0" style="background:rgba(6,8,11,.72)"></div>
		<!-- Modal content -->
		<div class="relative p-4 w-full max-w-md max-h-full mx-auto">
			<div class="relative gm-card shadow-xl">
				<div class="gm-card-body text-center">
					if action == "delete" {
						<i class="fas fa-trash-alt text-2xl mb-3" aria-hidden="true" style="color:var(--bad)"></i>
					} else {
						<i class="fas fa-exclamation-triangle text-2xl mb-3" aria-hidden="true" style="color:var(--warn)"></i>
					}
					<h3 id={ id + "-title" } class="gm-section-title mb-1">{ title }</h3>
					<p class="gm-meta mb-5">{ message }</p>
					<div class="flex items-center justify-center gap-2">
						<button type="button" onclick={ closeModal(id) } class="gm-btn gm-btn-ghost">
							Cancel
						</button>
						<button
							type="button"
							class={ confirmClass }
							hx-delete={ fmt.Sprintf("/jobs/%d", jobID) }
							hx-target="closest li"
							hx-swap="delete"
							data-job-name={ jobName }
							data-job-id={ fmt.Sprint(jobID) }
							id={ fmt.Sprintf("delete-btn-%d", jobID) }
							onclick={ triggerJobDelete(id, jobID, jobName) }
						>
							{ confirmText }
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
}

script triggerJobDelete(dialogId string, jobID uint, jobName string) {
	// Hide the dialog
	document.getElementById(dialogId).classList.add("hidden");
	document.getElementById(dialogId).classList.remove("flex");

	// Store data in a way that's accessible to event handlers
	window.lastDeletedJob = {
		id: jobID,
		name: jobName
	};

	// Add custom marker to track this deletion
	window.currentlyDeletingJob = true;
}

type JobsData struct {
	Jobs        []db.Job
	ConfigCount map[uint]int // Maps job ID to number of configs
}

templ Jobs(ctx context.Context, data JobsData) {
	@LayoutWithContext("Scheduled Jobs", ctx) {
		@jobsPageScript()
		<div id="jobs-container" class="jobs-page pb-mobile-nav">
			<div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
				<div>
					<h2 class="gm-page-title">Scheduled Jobs</h2>
					<p class="gm-muted">Cron-scheduled runs of one or more transfer configurations.</p>
				</div>
				<a href="/jobs/new" class="gm-btn gm-btn-primary">
					<i class="fas fa-plus" aria-hidden="true"></i>
					New job
				</a>
			</div>
			if len(data.Jobs) == 0 {
				<div class="gm-card gm-card-body text-center py-10">
					<p class="gm-body mb-1">No jobs yet</p>
					<p class="gm-muted mb-4">A job binds a schedule to one or more transfer configurations.</p>
					<a href="/jobs/new" class="gm-btn gm-btn-primary inline-flex">
						<i class="fas fa-plus" aria-hidden="true"></i>
						Create first job
					</a>
				</div>
			} else {
				<div class="gm-card overflow-hidden">
					<ul role="list" class="gm-rows">
						for _, job := range data.Jobs {
							<li>
								<div class="gm-row">
									<div class="flex flex-wrap items-center gap-2 mb-2">
										<a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) } class="gm-body font-medium truncate" style="color:var(--accent-text)">
											{ determineJobName(job) }
										</a>
										if job.GetEnabled() {
											<span class="gm-badge gm-badge-ok">
												<i class="fas fa-circle-check" aria-hidden="true"></i>
												Enabled
											</span>
										} else {
											<span class="gm-badge gm-badge-idle">
												<i class="fas fa-circle-pause" aria-hidden="true"></i>
												Disabled
											</span>
										}
									</div>
									<dl class="gm-kv mb-3">
										<dt>Schedule</dt>
										<dd><span class="mono">{ job.Schedule }</span></dd>
										<dt>Configs</dt>
										<dd>
											if count, ok := data.ConfigCount[job.ID]; ok && count > 1 {
												{ fmt.Sprintf("%d configurations", count) }
											} else if job.ConfigID > 0 {
												{ job.Config.Name }
											} else {
												{ "None" }
											}
										</dd>
										if job.LastRun != nil {
											<dt>Last run</dt>
											<dd class="num">{ job.LastRun.Format("2006-01-02 15:04:05") }</dd>
										}
										if job.NextRun != nil {
											<dt>Next run</dt>
											<dd class="num">
												{ job.NextRun.Format("2006-01-02 15:04:05") }
												<span style="color:var(--text-3)">&middot; { relativeTime(*job.NextRun) }</span>
											</dd>
										}
									</dl>
									<div class="gm-actions">
										<button
											hx-post={ fmt.Sprintf("/jobs/%d/run", job.ID) }
											hx-swap="none"
											class="gm-btn gm-btn-primary gm-btn-sm"
											data-job-id={ fmt.Sprint(job.ID) }
											data-job-name={ job.Name }
											onclick="window.runJob(this)"
										>
											<i class="fas fa-play" aria-hidden="true"></i>
											Run now
										</button>
										<a href={ templ.SafeURL(fmt.Sprintf("/jobs/%d", job.ID)) } class="gm-btn gm-btn-ghost gm-btn-sm">
											<i class="fas fa-pen-to-square" aria-hidden="true"></i>
											Edit
										</a>
										<button
											hx-post={ fmt.Sprintf("/jobs/%d/duplicate", job.ID) }
											hx-swap="innerHTML"
											hx-target="body"
											class="gm-btn gm-btn-ghost gm-btn-sm"
											data-job-id={ fmt.Sprint(job.ID) }
											data-job-name={ job.Name }
										>
											<i class="fas fa-clone" aria-hidden="true"></i>
											Duplicate
										</button>
										@JobDialog(
											fmt.Sprintf("delete-job-dialog-%d", job.ID),
											"Delete job",
											fmt.Sprintf("Are you sure you want to delete '%s'? This cannot be undone.", determineJobName(job)),
											"gm-btn gm-btn-danger",
											"Delete",
											"delete",
											job.ID,
											determineJobName(job),
										)
										<button
											type="button"
											onclick={ showModal(fmt.Sprintf("delete-job-dialog-%d", job.ID)) }
											class="gm-btn gm-btn-danger gm-btn-sm"
											aria-label={ "Delete job " + determineJobName(job) }
										>
											<i class="fas fa-trash" aria-hidden="true"></i>
											Delete
										</button>
									</div>
								</div>
							</li>
						}
					</ul>
				</div>
			}
			<p class="gm-muted mt-4">
				<i class="fas fa-info-circle mr-1" aria-hidden="true"></i>
				Jobs run on their cron schedule and transfer files between the configured source and destination.
			</p>
		</div>
	}
}

// Helper function to determine the job name (reuse this logic to keep it consistent)
func determineJobName(job db.Job) string {
	if job.Name != "" {
		return job.Name
	}
	return job.Config.Name
}

// jobsPageScript preserves the page's existing toast + HTMX bookkeeping.
templ jobsPageScript() {
	<script>
		function showToast(message, type) {
			const toastContainer = document.getElementById('toast-container');
			if (!toastContainer) return;

			const toast = document.createElement('div');
			toast.id = 'toast-' + type + '-' + Date.now();
			toast.className = 'gm-card flex items-center gap-3 w-full max-w-xs p-3 mb-2 shadow-lg transform translate-y-4 opacity-0 transition-all duration-300 ease-out';
			toast.role = 'alert';

			let iconClass, icon;
			if (type === 'success') {
				iconClass = 'gm-badge gm-badge-ok';
				icon = '<i class="fas fa-circle-check"></i>';
			} else if (type === 'error') {
				iconClass = 'gm-badge gm-badge-bad';
				icon = '<i class="fas fa-circle-xmark"></i>';
			} else {
				iconClass = 'gm-badge gm-badge-active';
				icon = '<i class="fas fa-circle-info"></i>';
			}

			toast.innerHTML = `
				<span class="${iconClass}">${icon}</span>
				<div class="gm-meta flex-1">${message}</div>
				<button type="button" class="gm-icon-btn" data-dismiss-target="#${toast.id}" aria-label="Dismiss notification">
					<i class="fas fa-times"></i>
				</button>
			`;

			toastContainer.appendChild(toast);

			setTimeout(() => {
				toast.classList.remove('translate-y-4', 'opacity-0');
			}, 10);

			toast.querySelector('button[data-dismiss-target]').addEventListener('click', function() {
				toast.classList.add('opacity-0', 'translate-y-4');
				setTimeout(() => { toast.remove(); }, 300);
			});

			setTimeout(() => {
				toast.classList.add('opacity-0', 'translate-y-4');
				setTimeout(() => { toast.remove(); }, 300);
			}, 5000);
		}

		// Global function to handle job running
		window.runJob = function(button) {
			const jobId = button.getAttribute('data-job-id');
			const jobName = button.getAttribute('data-job-name') || `Job #${jobId}`;

			button.addEventListener('htmx:afterRequest', function(event) {
				if (event.detail.successful) {
					let displayName = jobName;
					if (event.detail.headers && event.detail.headers['HX-Job-Name']) {
						displayName = event.detail.headers['HX-Job-Name'];
					}
					showToast(`Job "${displayName}" started successfully!`, 'success');
				} else {
					let errorMsg = `Failed to start job "${jobName}"`;
					if (event.detail.xhr && event.detail.xhr.responseText) {
						errorMsg = `Error: ${event.detail.xhr.responseText}`;
					}
					showToast(errorMsg, 'error');
				}
			}, { once: true });
		};

		document.addEventListener('DOMContentLoaded', function() {
			const hideButtons = document.querySelectorAll('[data-modal-hide]');
			hideButtons.forEach(button => {
				button.addEventListener('click', function() {
					const modalId = this.getAttribute('data-modal-hide');
					const modal = document.getElementById(modalId);
					if (!modal) return;
					modal.classList.add('hidden');
					modal.classList.remove('flex');
				});
			});
		});

		document.addEventListener('htmx:beforeRequest', function(event) {
			const path = event.detail.path;
			const method = event.detail.verb;

			if (path && method === 'DELETE' && path.match(/^\/jobs\/\d+$/)) {
				window.isJobDeleteRequest = true;
			}
		});

		document.addEventListener('htmx:afterRequest', function(event) {
			const isDeleteRequest =
				window.currentlyDeletingJob ||
				window.isJobDeleteRequest ||
				(event.detail.pathInfo && event.detail.pathInfo.requestPath &&
				 event.detail.pathInfo.requestPath.match(/^\/jobs\/\d+$/) &&
				 event.detail.verb === 'DELETE');

			if (isDeleteRequest && event.detail.successful) {
				let jobName = "Unknown";

				if (event.detail.elt && event.detail.elt.getAttribute) {
					jobName = event.detail.elt.getAttribute('data-job-name') || jobName;
				}

				if (jobName === "Unknown" && window.lastDeletedJob) {
					jobName = window.lastDeletedJob.name;
				}

				showToast(`Job "${jobName}" deleted successfully`, 'success');

				window.currentlyDeletingJob = false;
				window.isJobDeleteRequest = false;
				window.lastDeletedJob = null;
			}
		});

		document.addEventListener('htmx:responseError', function(event) {
			const isDeleteRequest =
				window.currentlyDeletingJob ||
				window.isJobDeleteRequest ||
				(event.detail.pathInfo && event.detail.pathInfo.requestPath &&
				 event.detail.pathInfo.requestPath.match(/^\/jobs\/\d+$/) &&
				 event.detail.verb === 'DELETE');

			if (isDeleteRequest) {
				let jobName = "Unknown";

				if (event.detail.elt && event.detail.elt.getAttribute) {
					jobName = event.detail.elt.getAttribute('data-job-name') || jobName;
				}

				if (jobName === "Unknown" && window.lastDeletedJob) {
					jobName = window.lastDeletedJob.name;
				}

				let errorMsg = `Failed to delete job "${jobName}"`;

				if (event.detail.xhr && event.detail.xhr.responseText) {
					errorMsg = `Error: ${event.detail.xhr.responseText}`;
				}

				showToast(errorMsg, 'error');

				window.currentlyDeletingJob = false;
				window.isJobDeleteRequest = false;
				window.lastDeletedJob = null;
			}
		});
	</script>
}
